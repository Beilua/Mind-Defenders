  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 874937625}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 037a2ef6659b321d496a5c47c5d4b95b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::JournalingManager
  fairySpeechText: {fileID: 1798960593}
  journalInputField: {fileID: 147641257}
  choiceContainer: {fileID: 1301293848}
  choice1Button: {fileID: 1494878191}
  choice2Button: {fileID: 1469032807}
  choice3Button: {fileID: 1372397323}
  choice1Text: {fileID: 1612081587}
  choice2Text: {fileID: 1660270279}
  choice3Text: {fileID: 1422683203}
  defaultButtonSprite: {fileID: 5083642616429109250, guid: f73343c29271e6badbd3636acf518bf3, type: 3}
  selectedButtonSprite: {fileID: 8779757653686099654, guid: fb67a92ba98e699608dec5e72c004b18, type: 3}
  journalContainer: {fileID: 1743647937}
  battleContainer: {fileID: 1166155084}
  allHeroes:
  - heroName: Bravery
    heroSprite: {fileID: 21300000, guid: b38522233d086ca90a18f45724560079, type: 3}
    selectionButtonText: Keberanian
    luminaReaction: 'Wah! Luar biasa! Keberanian ini nunjukkin kalau kamu nggak pasrah
      sama keadaan~ '
    journalPrompt: Hal apa yang membuat-mu merasa berani?
  - heroName: Happiness
    heroSprite: {fileID: 21300000, guid: b58e49b298b1f9c5e8dc88c75ad4eaa3, type: 3}
    selectionButtonText: Kesenangan
    luminaReaction: Wah~ Senang sekali ya! Selalu ingatlah dan syukuri kesenangan
      itu ya kawan!
    journalPrompt: Selalu ingatlah dan syukuri kesenangan itu ya kawan!
  - heroName: Kindness
    heroSprite: {fileID: 8492928385008896186, guid: c12a707c72146c8b0a62f0bf2e8b0d0a, type: 3}
    selectionButtonText: Kebaikan
    luminaReaction: Wah, berhati emas banget! Tetap peduli dengan orang lain, ya~
    journalPrompt: Kebaikan apa yang kamu lakukan hari ini?
  - heroName: Patience
    heroSprite: {fileID: 21300000, guid: 9d7045bf765349d6296f35ab126eea4e, type: 3}
    selectionButtonText: Kesabaran
    luminaReaction: Wah, pilihan yang sangat tenang! Memilih untuk sabar itu bisa
      membuat pikiran kita lebih jernih~
    journalPrompt: prompt pat
  - heroName: Honesty
    heroSprite: {fileID: 21300000, guid: b9ca4f6bf9aa3121ea3ffc8277054406, type: 3}
    selectionButtonText: Kejujuran
    luminaReaction: Wah, mengakui semuanya tanpa ditutupi menurutku itu langkah yang
      hebat, lho~
    journalPrompt: prompt honest
  - heroName: Determination
    heroSprite: {fileID: 21300000, guid: 91413c7ba2adda91eba16e0151748548, type: 3}
    selectionButtonText: Bertekad
    luminaReaction: Wah, tekad yang kuat banget! Berniat di situasi yang membuatmu
      ingin menyerah itu keren~
    journalPrompt: prompt det
  allMonsters:
  - monsterName: Distraction
    monsterSprite: {fileID: 21300000, guid: 180c67df4f495c74284f1b594650dbc3, type: 3}
    selectionButtonText: Distraksi
    luminaReaction: Tarik nafasmu secara perlahan, lalu hembuskan. Ga usah buru-buru,
      aku siap mendengarkan kapanpun!
    journalPrompt: prompt distract
    encouragementMessage: Distraksi muncul saat kita memikirkan banyak hal. Kamu
      bisa jeda sejenak untuk menata kembali prioritas, kawan!
  - monsterName: Sadness
    monsterSprite: {fileID: 21300000, guid: ca37287dd2a6ba89fb464f07765fb5f0, type: 3}
    selectionButtonText: Kesedihan
    luminaReaction: 'Tarik nafasmu secara perlahan, lalu hembuskan. Ga usah buru-buru,
      aku siap mendengarkan kapanpun!

'
    journalPrompt: prompt sad
    encouragementMessage: Kesedihan datang karena yang kamu hadapi berarti bagimu.
      Kita ga perlu buru-buru menghapus air mata itu, kawan~
  - monsterName: Hopelessness
    monsterSprite: {fileID: 21300000, guid: 9099e6cb415ce493da2c6aed9870cef1, type: 3}
    selectionButtonText: Putus Asa
    luminaReaction: Tarik nafasmu secara perlahan, lalu hembuskan. Ga usah buru-buru,
      aku siap mendengarkan kapanpun!
    journalPrompt: prompt hopels
    encouragementMessage: 'Keputusasaan datang ketika tenaga kita terkuras habis.
      Tapi ingat, kita masih bisa melangkah keluar dari labirin ini bersama!

'
  - monsterName: Burnout
    monsterSprite: {fileID: 21300000, guid: cfc75854e7e16553f97f7b8552d7262d, type: 3}
    selectionButtonText: Kelelahan
    luminaReaction: Tarik nafasmu secara perlahan, lalu hembuskan. Ga usah buru-buru,
      aku siap mendengarkan kapanpun!
    journalPrompt: prompt burn
    encouragementMessage: 'Burnout bukan sekadar lelah fisik biasa. Kamu sudah berjuang
      sejauh ini, dan kamu berhak untuk istirahat, kawan~

'
  - monsterName: Anxiety
    monsterSprite: {fileID: 21300000, guid: 00b087d4bf11c2018a32194e2fe4828c, type: 3}
    selectionButtonText: Kecemasan
    luminaReaction: 'Tarik nafasmu secara perlahan, lalu hembuskan. Ga usah buru-buru,
      aku siap mendengarkan kapanpun!

'
    journalPrompt: prompt anx
    encouragementMessage: 'Kecemasan sering kali membuat skenario terburuk. Namun,
      kamu ga perlu memikul beban itu sendirian sekarang!

'
  typingSpeed: 0.01
